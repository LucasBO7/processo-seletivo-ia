# Copie este arquivo para backend/.env e substitua somente os valores locais.

# Aplicação
APP__ENVIRONMENT=local
APP__LOG_LEVEL=INFO

# HTTP e CORS
HTTP__HOST=127.0.0.1
HTTP__PORT=8000
HTTP__CORS_ORIGINS=["http://localhost:5173"]
HTTP__CORS_ALLOW_CREDENTIALS=false

# PostgreSQL 16 (obrigatório)
POSTGRES__URL=postgresql+psycopg://startup_radar:startup_radar@localhost:5432/startup_radar
POSTGRES__POOL_SIZE=5
POSTGRES__MAX_OVERFLOW=5
POSTGRES__CONNECT_TIMEOUT_SECONDS=5

# Qdrant (obrigatório)
QDRANT__URL=http://localhost:6333
QDRANT__COLLECTION_NAME=nvidia_knowledge_v1
QDRANT__EMBEDDING_DIMENSION=1024
QDRANT__DISTANCE=cosine
QDRANT__TIMEOUT_SECONDS=5
# QDRANT__API_KEY=

# Modelos: valores reais serão definidos por specs funcionais futuras.
CHAT__PROVIDER=unset
CHAT__MODEL=unset
CHAT__TIMEOUT_SECONDS=30
CHAT__MAX_RETRIES=2
# CHAT__BASE_URL=
# CHAT__API_KEY=

EMBEDDINGS__PROVIDER=unset
EMBEDDINGS__MODEL=unset
EMBEDDINGS__TIMEOUT_SECONDS=30
EMBEDDINGS__MAX_RETRIES=2
# EMBEDDINGS__BASE_URL=
# EMBEDDINGS__API_KEY=

RERANKER__PROVIDER=cohere
RERANKER__MODEL=rerank-v3.5
RERANKER__TIMEOUT_SECONDS=30
RERANKER__MAX_RETRIES=2
# RERANKER__API_KEY=
