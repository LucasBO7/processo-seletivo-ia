# Copie este arquivo para backend/.env e substitua somente os valores locais.

# Aplicação
APP__ENVIRONMENT=local
APP__LOG_LEVEL=INFO

# HTTP e CORS
HTTP__HOST=127.0.0.1
HTTP__PORT=8000
HTTP__CORS_ORIGINS=["http://localhost:5173"]
HTTP__CORS_ALLOW_CREDENTIALS=false

# PostgreSQL 16 (obrigatório)
POSTGRES__URL=postgresql+psycopg://startup_radar:startup_radar@localhost:5432/startup_radar
POSTGRES__POOL_SIZE=5
POSTGRES__MAX_OVERFLOW=5
POSTGRES__CONNECT_TIMEOUT_SECONDS=5

# Qdrant (obrigatório)
QDRANT__URL=http://localhost:6333
QDRANT__COLLECTION_NAME=nvidia_knowledge_v1
QDRANT__EMBEDDING_DIMENSION=1024
QDRANT__DISTANCE=cosine
QDRANT__TIMEOUT_SECONDS=5
# QDRANT__API_KEY=

# Groq (a chave real deve existir apenas no arquivo .env local)
# GROQ__API_KEY=

# Query Planner (limites não sensíveis)
QUERY_PLANNER__MAX_QUERY_LENGTH=2000
QUERY_PLANNER__MAX_ITEMS_PER_LIST=20
QUERY_PLANNER__MAX_CLARIFICATION_QUESTIONS=3
QUERY_PLANNER__MAX_RATIONALE_LENGTH=500
QUERY_PLANNER__MAX_REPAIR_ATTEMPTS=1

# Retriever (limites não sensíveis)
RETRIEVER__MAX_RESULTS=20
RETRIEVER__EXCERPT_LENGTH=300

# Extractor Agent
EXTRACTOR__MAX_SOURCES_PER_STARTUP=10
EXTRACTOR__MAX_CONTEXT_CHARACTERS=12000
EXTRACTOR__MAX_FACT_LENGTH=1000
EXTRACTOR__MAX_ITEMS_PER_LIST=20
EXTRACTOR__MAX_REPAIR_ATTEMPTS=1

# Startup Classifier Agent
STARTUP_CLASSIFIER__MAX_SOURCES_PER_STARTUP=10
STARTUP_CLASSIFIER__MAX_CONTEXT_CHARACTERS=12000
STARTUP_CLASSIFIER__MAX_JUSTIFICATION_LENGTH=1000
STARTUP_CLASSIFIER__MAX_SIGNALS=20
STARTUP_CLASSIFIER__MAX_SIGNAL_DESCRIPTION_LENGTH=500
STARTUP_CLASSIFIER__MAX_REPAIR_ATTEMPTS=1

# Evidence Validator Agent
EVIDENCE_VALIDATOR__MAX_SOURCES_PER_STARTUP=10
EVIDENCE_VALIDATOR__MAX_ITEMS_PER_STARTUP=250
EVIDENCE_VALIDATOR__MAX_CONTEXT_CHARACTERS=20000
EVIDENCE_VALIDATOR__MAX_JUSTIFICATION_LENGTH=1000
EVIDENCE_VALIDATOR__MAX_REPAIR_ATTEMPTS=1

# Perfis de LLM compartilhados pelos agentes
LLM_FAST__MODEL=openai/gpt-oss-20b
LLM_FAST__TEMPERATURE=0
LLM_FAST__TIMEOUT_SECONDS=30
LLM_FAST__MAX_RETRIES=2

LLM_HEAVY__MODEL=openai/gpt-oss-120b
LLM_HEAVY__TEMPERATURE=0.1
LLM_HEAVY__TIMEOUT_SECONDS=30
LLM_HEAVY__MAX_RETRIES=2

EMBEDDINGS__PROVIDER=unset
EMBEDDINGS__MODEL=unset
EMBEDDINGS__TIMEOUT_SECONDS=30
EMBEDDINGS__MAX_RETRIES=2
# EMBEDDINGS__BASE_URL=
# EMBEDDINGS__API_KEY=

RERANKER__PROVIDER=cohere
RERANKER__MODEL=rerank-v3.5
RERANKER__TIMEOUT_SECONDS=30
RERANKER__MAX_RETRIES=2
# RERANKER__API_KEY=
